<?xml version="1.0"?>
<package format="3">
  <name>inspection_bringup</name>
  <version>0.1.0</version>
  <description>Configuration and launch files for mock, recording-only, and hardware acquisition modes.</description>
  <maintainer email="maintainer@example.com">Tank Inspection Maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>eddy_driver</exec_depend>
  <exec_depend>inspection_mock_sensors</exec_depend>
  <exec_depend>inspection_livox_adapter</exec_depend>
  <exec_depend>inspection_sync</exec_depend>
  <exec_depend>inspection_tools</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- livox_ros_driver2 为可选硬件驱动(vendor, 需外部 Livox-SDK), 本机暂缺故不列为构建依赖;
       需要 MID-360 时从 src/livox_ros_driver2 去掉 COLCON_IGNORE 并装好 SDK 再构建。 -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
